{
  "name": "quangjs",
  "type": "module",
  "version": "0.2.0",
  "description": "js/ts library for common quang utilities",
  "author": "jessekrubin <jessekrubin@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/jessekrubin/quangjs#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jessekrubin/quangjs.git"
  },
  "bugs": {
    "url": "https://github.com/jessekrubin/quangjs/issues"
  },
  "keywords": [
    "jawascript",
    "typescript",
    "quang"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "quangjs": "./dist/cli.js"
  },
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build-fast": "tsup",
    "build": "tsup --dts",
    "check": "eslint . && prettier --check .",
    "change": "changeset",
    "fmt": "prettier --write .",
    "fmtc": "prettier --check .",
    "lint": "eslint .",
    "test": "vitest --run",
    "cov": "vitest --coverage",
    "tsc": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.12",
    "@jsse/eslint-config": "^0.2.29",
    "@jsse/tsconfig": "^0.2.4",
    "@types/node": "^22.10.10",
    "@vitest/coverage-v8": "^3.0.4",
    "eslint": "^9.15.0",
    "prettier": "^3.3.3",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.11",
    "vitest": "^3.0.4"
  }
}
